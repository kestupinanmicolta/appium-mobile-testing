{
  "name": "appium-serenity-mobile",
  "version": "1.0.0",
  "description": "Mobile testing with Serenity.js, Appium, WebdriverIO and TypeScript",
  "scripts": {
    "test": "wdio wdio.conf.ts",
    "test:report": "npx @serenity-js/html-reporter serve --dir ./reports/serenity-js --open",
    "clean": "rm -rf target reports"
  },
  "dependencies": {
    "@cucumber/cucumber": "^10.3.0",
    "@serenity-js/assertions": "^3.45.8",
    "@serenity-js/console-reporter": "^3.45.8",
    "@serenity-js/core": "^3.45.8",
    "@serenity-js/cucumber": "^3.45.8",
    "@serenity-js/html-reporter": "^3.45.8",
    "@serenity-js/web": "^3.45.8",
    "@serenity-js/webdriverio": "^3.45.8",
    "@wdio/cli": "^9.30.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.1",
    "webdriverio": "^9.30.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "appium": "^2.5.0",
    "appium-uiautomator2-driver": "^3.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  }
}
