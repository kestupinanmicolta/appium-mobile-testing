{
  "name": "appium-serenity-mobile",
  "version": "1.0.0",
  "description": "Mobile testing with Serenity.js, Appium and TypeScript",
  "scripts": {
    "test": "cucumber-js",
    "test:login": "cucumber-js --tags @login",
    "test:catalog": "cucumber-js --tags @catalog",
    "test:cart": "cucumber-js --tags @cart",
    "report": "serenity-bdd run",
    "clean": "rm -rf target"
  },
  "dependencies": {
    "@cucumber/cucumber": "^10.3.0",
    "@serenity-js/assertions": "^3.43.0",
    "@serenity-js/console-reporter": "^3.43.0",
    "@serenity-js/core": "^3.43.0",
    "@serenity-js/cucumber": "^3.43.0",
    "@serenity-js/webdriverio": "^3.43.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "appium": "^2.5.0",
    "appium-uiautomator2-driver": "^3.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0",
    "webdriverio": "^9.27.1"
  }
}
